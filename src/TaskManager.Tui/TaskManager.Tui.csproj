<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AssemblyName>taskmgr</AssemblyName>
    <RootNamespace>TaskManager.Tui</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>taskmgr</ToolCommandName>
    <PackageId>TaskManager.Tui</PackageId>
    <Version>1.0.0</Version>
    <Authors>Joel Christner</Authors>
    <Description>Cross-platform terminal task manager: processes, per-core CPU, memory, disk, and network over time, with the same columns and definitions on Windows, Linux, and macOS.</Description>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUIKit" Version="1.5.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PerformanceStatistics.Monitoring\PerformanceStatistics.Monitoring.csproj" />
  </ItemGroup>

</Project>
