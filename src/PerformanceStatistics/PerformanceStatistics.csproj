<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>PerformanceStatistics.xml</DocumentationFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title></Title>
		<Version>2.1.0</Version>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Description>Cross-platform .NET library for capturing real-time performance statistics. Supports Windows, Linux, and macOS. Monitor CPU, memory, disk, and process metrics with a simple API.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/PerformanceStatistics</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/PerformanceStatistics</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageTags>performance counters</PackageTags>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<PackageReleaseNotes>Consistent cross-platform semantics: shared base classes; process CPU now measured across MonitoredProcesses accesses and normalized to machine capacity everywhere; macOS uses native APIs (accurate available memory, de-duplicated APFS disk space, file descriptor counts, physical footprint); Windows CPU/memory via kernel32 and long-lived disk counters; Linux per-disk in-flight queues and partition-safe disk stats. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\Assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Update="PerformanceStatistics.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
