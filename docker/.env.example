# Copy to docker/.env and change these.
TASKMGR_ADMIN_PASSWORD=change-me
TASKMGR_AGENT_KEY=change-me-too
# Optional read-only login (user "viewer"):
TASKMGR_VIEWER_PASSWORD=
# Ports on this machine:
TASKMGR_SERVER_PORT=8080
TASKMGR_WEB_PORT=3000
# linux-agent profile:
TASKMGR_DOCKER_HOST_ID=docker-host
TASKMGR_DOCKER_HOST_ACTIONS=
